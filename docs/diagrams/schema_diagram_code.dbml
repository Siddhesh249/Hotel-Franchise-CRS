// Hotel Franchise Central Reservation System (CRS) with Overbooking Logic
// Paste this whole file into https://dbdiagram.io -> New Diagram
// (replace the boilerplate demo text completely with this)
// Mirrors SQL/hotel_crs_ddl.sql

Table franchise {
  franchise_id      int [pk, increment]
  franchise_name    varchar [unique, not null]
  headquarters_city varchar
  founded_year      int
}

Table hotel {
  hotel_id       int [pk, increment]
  franchise_id   int [not null]
  hotel_name     varchar [not null]
  city           varchar [not null]
  state          varchar
  address        varchar
  star_rating    int [note: '1 to 5']
  contact_number varchar

  Note: 'UNIQUE(hotel_name, city)'
}

Table room_type {
  room_type_id  int [pk, increment]
  hotel_id      int [not null]
  type_name     varchar [not null]
  base_price    decimal [not null]
  max_occupancy int [default: 2]
  total_rooms   int [not null]

  Note: 'UNIQUE(hotel_id, type_name) and UNIQUE(room_type_id, hotel_id). total_rooms = physical capacity.'
}

Table room {
  room_id       int [pk, increment]
  hotel_id      int [not null]
  room_type_id  int [not null]
  room_number   varchar [not null]
  floor_number  int
  room_status   varchar [note: 'Available / Maintenance / OutOfService']

  Note: 'UNIQUE(hotel_id, room_number). FOREIGN KEY (room_type_id, hotel_id) -> room_type, so the deliberate hotel_id copy can never disagree with the room type.'
}

Table guest {
  guest_id      int [pk, increment]
  first_name    varchar [not null]
  last_name     varchar [not null]
  email         varchar [unique, not null]
  phone         varchar
  address       varchar
  password_hash varchar [not null]
  registered_on date
}

Table staff_account {
  staff_id      int [pk, increment]
  hotel_id      int [note: 'NULL for Admin, required for Staff (enforced by triggers)']
  full_name     varchar [not null]
  email         varchar [unique, not null]
  password_hash varchar [not null]
  role          varchar [note: 'Admin / Staff']
  created_on    datetime
}

Table overbooking_policy {
  policy_id           int [pk, increment]
  room_type_id        int [unique, not null]
  overbook_percentage decimal [default: 0, note: '0 to 50']
  updated_on          datetime

  Note: 'One optional policy row per room type. Base buffer = FLOOR(total_rooms * % / 100).'
}

Table room_type_inventory {
  inventory_id  bigint [pk, increment]
  room_type_id  int [not null]
  stay_date     date [not null]
  booked_count  int [default: 0]

  Note: 'UNIQUE(room_type_id, stay_date). Per-night ledger: the rows the booking procedures read and lock.'
}

Table daily_inventory_plan {
  plan_id            bigint [pk, increment]
  hotel_id           int [not null]
  stay_date          date [not null]
  physical_rooms     int
  base_buffer_rooms  int
  buffer_rooms       int [note: 'adaptive buffer for this night']
  max_sellable_rooms int
  booked_rooms       int
  generated_on       datetime

  Note: 'UNIQUE(hotel_id, stay_date). Derived data for the admin chart, rebuilt by sp_refresh_*_inventory_plan.'
}

Table booking {
  booking_id       int [pk, increment]
  guest_id         int [not null]
  room_type_id     int [not null]
  check_in_date    date [not null]
  check_out_date   date [not null]
  num_guests       int [default: 1]
  special_requests varchar
  booking_status   varchar [note: 'Confirmed / Waitlisted / Cancelled']
  is_overbooked    boolean [default: false]
  booking_date     datetime
  total_amount     decimal [not null]

  Note: 'CHECK(check_out_date > check_in_date)'
}

Table room_assignment {
  assignment_id int [pk, increment]
  booking_id    int [unique, not null]
  room_id       int [not null]
  assigned_on   datetime

  Note: 'The hard physical layer. A BEFORE INSERT trigger requires: confirmed booking, stay not over, right room type, room Available, payment completed, no overlapping assignment for the room.'
}

Table payment {
  payment_id      int [pk, increment]
  booking_id      int [not null]
  amount          decimal [not null]
  payment_date    datetime
  payment_method  varchar [note: 'Card / UPI / NetBanking / Cash']
  payment_status  varchar [note: 'Completed / Refunded']
  live_booking_id int [note: 'generated: booking_id while Completed, else NULL; UNIQUE => one live payment per booking']
}

Table cancellation_history {
  cancellation_id     int [pk, increment]
  booking_id          int [unique, not null]
  cancelled_on        datetime
  cancellation_reason varchar
  refund_amount       decimal [default: 0]
}

// ---------------------------- Relationships ----------------------------
Ref: hotel.franchise_id > franchise.franchise_id
Ref: room_type.hotel_id > hotel.hotel_id
Ref: room.(room_type_id, hotel_id) > room_type.(room_type_id, hotel_id)
Ref: staff_account.hotel_id > hotel.hotel_id
Ref: overbooking_policy.room_type_id - room_type.room_type_id
Ref: room_type_inventory.room_type_id > room_type.room_type_id
Ref: daily_inventory_plan.hotel_id > hotel.hotel_id
Ref: booking.guest_id > guest.guest_id
Ref: booking.room_type_id > room_type.room_type_id
Ref: room_assignment.booking_id - booking.booking_id
Ref: room_assignment.room_id > room.room_id
Ref: payment.booking_id > booking.booking_id
Ref: cancellation_history.booking_id - booking.booking_id
